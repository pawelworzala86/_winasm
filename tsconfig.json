{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    
    // Musisz dodać noEmit, aby allowImportingTsExtensions działało:
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["sources/**/*"]
}